<?php
/**
 * =====================================================
 *  إعدادات قاعدة البيانات - واحة المنصورية
 *
 *  على استضافة مجانية (InfinityFree و أمثالها) استخدم MySQL:
 *  1) غيّر DB_DRIVER إلى 'mysql'
 *  2) املأ بيانات قاعدة MySQL من لوحة الاستضافة
 *     (ستجدها في: MySQL Databases => اسم القاعدة والمستخدم والهوست)
 *  3) أنشئ القاعدة من لوحة التحكم أولاً (النظام ينشئ الجداول تلقائياً)
 *
 *  على جهازك المحلي اترك DB_DRIVER على 'sqlite' (بدون أي إعداد)
 * =====================================================
 */

define('DB_DRIVER', 'mysql');            // 'mysql' أو 'sqlite'

// --- بيانات MySQL (تُستخدم فقط عندما DB_DRIVER = 'mysql') ---
define('DB_HOST', 'sqlXXX.infinityfree.com');   // عنوان سيرفر MySQL من لوحة الاستضافة
define('DB_NAME', 'if0_XXXXXXXX_wahat');       // اسم قاعدة البيانات
define('DB_USER', 'if0_XXXXXXXX');             // اسم مستخدم قاعدة البيانات
define('DB_PASS', 'كلمة_مرور_القاعدة');        // كلمة مرور قاعدة البيانات
